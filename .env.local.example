# MongoDB Atlas Connection String
# Get your connection string from MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/quizapp?retryWrites=true&w=majority

# Database Name (Optional - defaults to 'quizapp')
MONGODB_DB_NAME=quizapp

# JWT Secret for Authentication
# SECURITY: Must be at least 32 characters long
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-random-string-minimum-32-characters-long

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secure-random-string-minimum-32-characters

# Application Name (Optional)
NEXT_PUBLIC_APP_NAME=Quiz App

# Email Configuration
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# For other providers: Check their SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Quiz App <your-email@gmail.com>

# Redis Configuration (Optional - for caching)
# If not set, caching will be disabled
REDIS_URL=redis://localhost:6379

# Rate Limiting (Optional)
# Requests per minute for API endpoints
RATE_LIMIT_API=100
RATE_LIMIT_LOGIN=5

# Environment
NODE_ENV=development

# SECURITY CHECKLIST:
# ✓ JWT_SECRET must be at least 32 characters (enforced by app)
# ✓ Use strong, unique passwords for MongoDB
# ✓ Enable MongoDB IP whitelist in production
# ✓ Use environment-specific secrets (dev/staging/prod)
# ✓ Enable 2FA on MongoDB Atlas account
# ✓ Rotate secrets regularly
# ✓ Never commit .env.local to version control
# ✓ For production, set these in Vercel/hosting dashboard
